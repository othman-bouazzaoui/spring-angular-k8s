{
  "/api": {
    "target": "http://localhost:8080",
    "secure": false,
    "logLevel": "debug",
    "changeOrigin": true,
    "pathRewrite": {
      "^/api": "/api/"
    }
  },
  "/service-notification-ws/**": {
    "target": "ws://localhost:7084",
    "secure": false,
    "logLevel": "debug",
    "ws": true,
    "changeOrigin": true
  }
}
